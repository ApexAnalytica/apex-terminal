# Use a flat, npm-style node_modules layout under pnpm.
#
# Vercel builds this app with pnpm; CI and local builds use npm. `three`,
# `geojson`, and other type-only modules are pulled in transitively, and npm
# hoists their `@types/*` into a flat `node_modules/@types`, so `next build`'s
# TypeScript step resolves `import ... from "three" | "geojson"` and passes.
# pnpm's default isolated layout does NOT hoist transitive `@types` to the app,
# so on Vercel tsc failed: "Cannot find module 'X' or its type declarations".
#
# `node-linker=hoisted` makes pnpm lay out node_modules flat like npm, giving
# parity with the layout that already builds everywhere else and fixing the
# whole class of transitive-`@types` resolution errors in one place.
node-linker=hoisted
